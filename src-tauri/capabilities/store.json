{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "store",
  "description": "Lets the Chrome Web Store / Edge Add-ons window install extensions into Takaro.",
  "windows": ["store"],
  "remote": {
    "urls": ["https://chromewebstore.google.com/*", "https://microsoftedge.microsoft.com/*"]
  },
  "permissions": ["allow-install-extension", "allow-extension-installed", "allow-reload-main"]
}
